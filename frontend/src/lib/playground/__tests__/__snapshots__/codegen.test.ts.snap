하위 그래프의 중간 메시지·도구 호출은 부모 대화에 섞이지 않는다 (컨텍스트 격리).
내부 구조: agent/subagents/writing_team/graph.py"""

from langchain.messages import AIMessage

from agent.state import State
from agent.subagents.writing_team.graph import graph as _subgraph


def writing_team(state: State) -> dict:
    """서브 에이전트 'writing_team' 을(를) 실행한다. config(thread, 콜백, interrupt)는 자동으로 전파된다."""
    result = _subgraph.invoke({"messages": state["messages"]})
    answer = result["messages"][-1]
