  "README.md": "# LangGraph Agent (AgentLab Playground 생성)

\`\`\`mermaid
flowchart TD
  __start__([START])
  retrieve[retrieve]
  generate[generate]
  grade[grade]
  rewrite_query[rewrite_query]
  __end__([END])
  __start__ --> retrieve
  retrieve --> generate
  generate --> grade
  grade -.->|pass| __end__
  grade -.->|retry| rewrite_query
  rewrite_query --> retrieve
\`\`\`

## 실행

\`\`\`bash
pip install -r requirements.txt
cp .env.example .env  # OPENAI_API_KEY 입력
python main.py
\`\`\`

## 구조

| 파일 | 역할 |
| --- | --- |
| \`agent/state.py\` | 공유 상태 스키마와 리듀서 |
| \`agent/nodes/*.py\` | 노드별 구현 (retrieve, generate, grade, rewrite_query) |
| \`agent/routing.py\` | 조건부 엣지 라우팅 함수 / Send fan-out |
| \`agent/graph.py\` | StateGraph 조립 및 컴파일 |
| \`main.py\` | 스트리밍 실행 데모 |
| \`langgraph.json\` | LangGraph Server(Agent Server) 배포 설정 |

## 배포

\`\`\`bash
pip install -U "langgraph-cli[inmem]"
langgraph dev   # 로컬 Agent Server + Studio
\`\`\`
",
  "agent/__init__.py": """"AgentLab 플레이그라운드에서 생성된 LangGraph 에이전트."""
",
  "agent/config.py": """"공통 설정: 모델 ID 는 환경변수에서 읽는다 (12-factor)."""

import os

from langchain.chat_models import init_chat_model

MODEL = os.getenv("LAB_MODEL", "openai:gpt-5-mini")


def get_llm(model: str | None = None):
    """채팅 모델 인스턴스. model 을 주면 그 모델(노드별 지정), 아니면 LAB_MODEL.

    GPT-5 계열은 temperature 를 지원하지 않으므로 지정하지 않는다.
    """
    return init_chat_model(model or MODEL)
",
  "agent/graph.py": """"그래프 조립: 노드 등록 → 엣지 연결 → 컴파일.

이 파일은 플레이그라운드 캔버스의 구조를 그대로 반영한다.
"""

from langgraph.checkpoint.memory import InMemorySaver
from langgraph.graph import END, START, StateGraph
from langgraph.types import RetryPolicy

from agent.nodes import generate, grade, retrieve, rewrite_query
from agent.routing import route_grade
from agent.state import State


def build_graph(checkpointer=None, use_default_checkpointer: bool = True):
    """StateGraph 를 구성하고 컴파일한다."""
    builder = StateGraph(State)

    builder.add_node("retrieve", retrieve)
    builder.add_node("generate", generate, retry_policy=RetryPolicy(max_attempts=3))
    builder.add_node("grade", grade)
    builder.add_node("rewrite_query", rewrite_query, retry_policy=RetryPolicy(max_attempts=3))

    builder.add_edge(START, "retrieve")
    builder.add_edge("retrieve", "generate")
    builder.add_edge("generate", "grade")
    builder.add_conditional_edges("grade", route_grade, {"pass": END, "retry": "rewrite_query"})
    builder.add_edge("rewrite_query", "retrieve")

    if checkpointer is None and use_default_checkpointer:
        checkpointer = InMemorySaver()
    return builder.compile(checkpointer=checkpointer, name="agent")


# LangGraph Server(langgraph.json)용 export — 서버가 자체 체크포인터를 주입한다.
graph = build_graph(use_default_checkpointer=False)
",
  "agent/nodes/__init__.py": """"노드 패키지: 각 노드는 개별 모듈로 분리되어 있다."""

from agent.nodes.generate import generate
from agent.nodes.grade import grade
from agent.nodes.retrieve import retrieve
from agent.nodes.rewrite_query import rewrite_query

__all__ = ["generate", "grade", "retrieve", "rewrite_query"]
",
  "agent/nodes/generate.py": """"'generate' — LLM 노드."""

from langchain.messages import SystemMessage

from agent.config import get_llm
from agent.state import State

PROMPT = "참고 문서만 근거로 답하세요. 문서에 없으면 모른다고 답하세요."
llm = get_llm()


def generate(state: State) -> dict:
    """대화 기록을 모델에 전달하고 응답 메시지를 상태에 추가한다."""
    system = PROMPT
    if state.get("context"):
        system += "\\n\\n[참고 문서]\\n" + state["context"]
    response = llm.invoke([SystemMessage(system), *state["messages"]])
    return {"messages": [response]}
",
  "agent/nodes/grade.py": """"'grade' — Evaluator (Reflection / Evaluator-Optimizer).

구조화 출력으로 pass/retry 를 판정하고, retry 면 피드백을 메시지로 남겨 생성 노드가 개선하게 한다.
반복 상한(MAX_ITERATIONS)으로 무한 루프를 막는다."""

from typing import Literal

from langchain.messages import HumanMessage, SystemMessage
from pydantic import BaseModel, Field

from agent.config import get_llm
from agent.state import State

CRITERIA = "답변의 모든 주장이 참고 문서에 근거하면 pass"
MAX_ITERATIONS = 2


class Verdict(BaseModel):
    """평가 결과."""

    verdict: Literal["pass", "retry"] = Field(description="기준을 만족하면 pass, 아니면 retry")
    feedback: str = Field(description="개선이 필요하면 구체적인 피드백")


grader = get_llm().with_structured_output(Verdict)


def grade(state: State) -> dict:
    """직전 답변을 평가한다."""
    count = state.get("grade_count", 0) + 1
    question = next((m.text for m in state["messages"] if isinstance(m, HumanMessage)), "")
    answer = state["messages"][-1].text
    result: Verdict = grader.invoke(
        [
            SystemMessage(f"당신은 엄격한 평가자입니다. 평가 기준: {CRITERIA}"),
            HumanMessage(f"질문: {question}\\n\\n답변: {answer}"),
        ]
    )
    print(f"  ⚖️  평가 #{count}: {result.verdict}")
    update: dict = {"grade_count": count, "grade_verdict": result.verdict}
    if result.verdict == "retry" and count < MAX_ITERATIONS:
        update["messages"] = [HumanMessage(f"[평가 피드백] {result.feedback} — 피드백을 반영해 다시 작성하세요.")]
    return update
",
  "agent/nodes/retrieve.py": """"'retrieve' — 마지막 사용자 질문으로 문서를 검색해 state.context 에 저장한다."""

from langchain.messages import HumanMessage

from agent.retriever import get_retriever
from agent.state import State

retriever = get_retriever(k=3)


def retrieve(state: State) -> dict:
    """가장 최근 사용자 메시지를 질의로 사용한다."""
    query = next((m.text for m in reversed(state["messages"]) if isinstance(m, HumanMessage)), "")
    docs = retriever.invoke(query)
    context = "\\n".join(f"- ({d.metadata.get('source')}) {d.page_content}" for d in docs)
    print(f"  🔎 '{query[:40]}' → {len(docs)}건 검색")
    return {"context": context}
",
  "agent/nodes/rewrite_query.py": """"'rewrite_query' — LLM 노드."""

from langchain.messages import SystemMessage

from agent.config import get_llm
from agent.state import State

PROMPT = "검색이 잘 되도록 사용자 질문을 더 구체적인 검색 질의 한 줄로 바꾸세요."
llm = get_llm()


def rewrite_query(state: State) -> dict:
    """대화 기록을 모델에 전달하고 응답 메시지를 상태에 추가한다."""
    system = PROMPT
    if state.get("context"):
        system += "\\n\\n[참고 문서]\\n" + state["context"]
    response = llm.invoke([SystemMessage(system), *state["messages"]])
    return {"messages": [response]}
",
  "agent/retriever.py": """"데모용 벡터 스토어 & 리트리버.

운영에서는 InMemoryVectorStore 대신 pgvector / Qdrant / Pinecone 등을 사용한다.
"""

from langchain_core.documents import Document
from langchain_core.vectorstores import InMemoryVectorStore
from langchain_openai import OpenAIEmbeddings

DOCS = [
    Document(page_content="LangGraph 는 상태(State), 노드(Node), 엣지(Edge)로 에이전트 워크플로를 그래프로 표현한다.", metadata={"source": "langgraph"}),
    Document(page_content="체크포인터(Checkpointer)는 매 스텝의 상태를 저장해 대화 메모리, 장애 복구, Human-in-the-loop 를 가능하게 한다.", metadata={"source": "persistence"}),
    Document(page_content="RAG 는 질문과 관련된 문서를 검색해 LLM 의 컨텍스트에 넣어 환각을 줄이는 기법이다.", metadata={"source": "rag"}),
    Document(page_content="환불은 결제 후 14일 이내 가능하며 영업일 기준 3~5일이 소요된다.", metadata={"source": "faq"}),
    Document(page_content="서울의 가을 여행지로는 경복궁, 북촌 한옥마을, 남산 서울타워, 한강 공원이 인기가 많다.", metadata={"source": "travel"}),
]

_store = InMemoryVectorStore(OpenAIEmbeddings(model="text-embedding-3-small"))
_store.add_documents(DOCS)


def get_retriever(k: int = 3):
    """유사도 검색 리트리버."""
    return _store.as_retriever(search_kwargs={"k": k})
",
  "agent/routing.py": """"라우팅 함수 모음: add_conditional_edges 에 전달된다.

라우팅 함수는 노드가 아니다. 상태를 읽고 '다음에 갈 곳'만 반환한다.
반환 타입의 Literal 은 그래프 시각화와 정적 검증에 사용된다.
"""

from typing import Literal



from agent.state import State


def route_grade(state: State) -> Literal["pass", "retry"]:
    """평가 결과 또는 반복 상한에 따라 분기한다. (pass → __end__, retry → rewrite_query)"""
    from agent.nodes.grade import MAX_ITERATIONS

    if state.get("grade_verdict") == "pass" or state.get("grade_count", 0) >= MAX_ITERATIONS:
        return "pass"
    return "retry"
",
  "agent/state.py": """"그래프 상태(State) 정의.

MessagesState 는 \`messages: Annotated[list[AnyMessage], add_messages]\` 를 포함한다.
add_messages 리듀서 덕분에 노드가 반환한 메시지는 덮어쓰지 않고 '추가'된다.
"""

from langgraph.graph import MessagesState


class State(MessagesState, total=False):
    """에이전트 전체가 공유하는 상태."""

    context: str  # Retriever 가 채우는 검색 문맥
    grade_count: int  # 평가 반복 횟수
    grade_verdict: str  # "pass" | "retry"
",
  "langgraph.json": "{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent": "./agent/graph.py:graph"
  },
  "env": ".env"
}
",
  "main.py": """"실행 진입점: 데모 입력으로 그래프를 스트리밍 실행한다.

    python main.py
"""

import uuid

from langgraph.errors import GraphRecursionError

from agent.graph import build_graph

DEMO_INPUT = "체크포인터는 무슨 역할을 하나요?"


def show(update: object) -> None:
    """노드가 반환한 상태 업데이트를 읽기 좋게 출력한다."""
    if not isinstance(update, dict):
        return
    for msg in update.get("messages", []) or []:
        role = getattr(msg, "type", "?")
        name = f"({msg.name})" if getattr(msg, "name", None) else ""
        if getattr(msg, "tool_calls", None):
            calls = ", ".join(f"{t['name']}({t['args']})" for t in msg.tool_calls)
            print(f"   [{role}{name}] 🛠  {calls}")
        else:
            print(f"   [{role}{name}] {str(msg.content)[:400]}")
    for key, value in update.items():
        if key != "messages":
            print(f"   · {key} = {str(value)[:200]}")


def run(graph, payload, config) -> list:
    """스트리밍 실행. interrupt 가 발생하면 그 값들을, 끝까지 돌면 빈 리스트를 반환한다."""
    for chunk in graph.stream(payload, config, stream_mode="updates"):
        for node, update in chunk.items():
            if node == "__interrupt__":
                for it in update:
                    print(f"\\n⏸  interrupt: {it.value}")
                return [it.value for it in update]
            print(f"\\n▶ {node}")
            show(update)
    return []



def main() -> None:
    graph = build_graph()
    config = {"configurable": {"thread_id": str(uuid.uuid4())}, "recursion_limit": 25, "run_name": "agentlab-demo", "tags": ["agentlab", "demo"], "metadata": {"source": "agentlab-playground"}}
    print("노드:", ", ".join(n for n in graph.get_graph().nodes if not n.startswith("__")))
    print(f"입력: {DEMO_INPUT}")
    try:
        interrupted = run(graph, {"messages": [{"role": "user", "content": DEMO_INPUT}]}, config)
        if interrupted:
            print("(interrupt 발생 — Command(resume=...) 로 재개하세요)")
    except GraphRecursionError:
        print("\\n⛔ recursion_limit 초과: 루프의 종료 조건을 확인하세요.")
        raise
    print("\\n✅ 실행 완료")


if __name__ == "__main__":
    main()
