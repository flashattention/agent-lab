",
  "agent/__init__.py": """"AgentLab 플레이그라운드에서 생성된 LangGraph 에이전트."""
",
  "agent/config.py": """"공통 설정: 모델 ID 는 환경변수에서 읽는다 (12-factor)."""

import os

from langchain.chat_models import init_chat_model

MODEL = os.getenv("LAB_MODEL", "openai:gpt-5-mini")


def get_llm(model: str | None = None):
    """채팅 모델 인스턴스. model 을 주면 그 모델(노드별 지정), 아니면 LAB_MODEL.

    GPT-5 계열은 temperature 를 지원하지 않으므로 지정하지 않는다.
    """
    return init_chat_model(model or MODEL)
",
  "agent/graph.py": """"그래프 조립: 노드 등록 → 엣지 연결 → 컴파일.

이 파일은 플레이그라운드 캔버스의 구조를 그대로 반영한다.
"""

from langgraph.checkpoint.memory import InMemorySaver
from langgraph.graph import END, START, StateGraph
from langgraph.types import RetryPolicy

from agent.nodes import approval, executor, support_agent
from agent.routing import route_approval
from agent.state import State


def build_graph(checkpointer=None, use_default_checkpointer: bool = True):
    """StateGraph 를 구성하고 컴파일한다."""
    builder = StateGraph(State)

    builder.add_node("support_agent", support_agent, retry_policy=RetryPolicy(max_attempts=3))
    builder.add_node("approval", approval)
    builder.add_node("executor", executor, retry_policy=RetryPolicy(max_attempts=3))

    builder.add_edge(START, "support_agent")
    builder.add_edge("support_agent", "approval")
    builder.add_conditional_edges("approval", route_approval, {"approve": "executor", "reject": "support_agent"})
    builder.add_edge("executor", END)

    if checkpointer is None and use_default_checkpointer:
        checkpointer = InMemorySaver()
    return builder.compile(checkpointer=checkpointer, name="agent")


# LangGraph Server(langgraph.json)용 export — 서버가 자체 체크포인터를 주입한다.
graph = build_graph(use_default_checkpointer=False)
",
  "agent/nodes/__init__.py": """"노드 패키지: 각 노드는 개별 모듈로 분리되어 있다."""

from agent.nodes.approval import approval
from agent.nodes.executor import executor
from agent.nodes.support_agent import support_agent

__all__ = ["approval", "executor", "support_agent"]
",
  "agent/nodes/approval.py": """"'approval' — Human-in-the-loop.

interrupt() 는 그래프 실행을 멈추고 값을 클라이언트에 전달한다. 체크포인터가 상태를 저장해 두므로
나중에 graph.invoke(Command(resume=...), config) 로 같은 thread 를 이어서 실행할 수 있다.
주의: 재개 시 이 노드는 '처음부터' 다시 실행되므로 interrupt 이전에 부작용(side effect)을 두지 않는다."""

from langchain.messages import HumanMessage, ToolMessage
from langgraph.types import interrupt

from agent.state import State

QUESTION = "이 환불 처리안을 승인하시겠습니까?"


def approval(state: State) -> dict:
    """사람의 승인/거절과 피드백을 받는다. 직전 메시지가 도구 호출이면 그 호출을 승인받는다."""
    last = state["messages"][-1]
    calls = getattr(last, "tool_calls", None) or []
    request: dict = {"question": QUESTION, "draft": last.text}
    if calls:
        request["tool_calls"] = [{"name": c["name"], "args": c["args"]} for c in calls]
    decision = interrupt(request)
    if not isinstance(decision, dict):
        decision = {"approved": bool(decision)}
    approved = decision.get("approved", True)
    update: dict = {"approval_decision": "approve" if approved else "reject"}
    feedback = decision.get("feedback") or ""
    if not approved and calls:
        # 도구 호출마다 응답(ToolMessage)이 있어야 모델이 대화를 이어갈 수 있다 (tool_calls 프로토콜)
        update["messages"] = [ToolMessage(content=f"[검토자 거절] {feedback or '실행하지 않았습니다.'}", tool_call_id=c["id"]) for c in calls]
    elif not approved and feedback:
        update["messages"] = [HumanMessage(f"[검토자 피드백] {feedback}")]
    return update
",
  "agent/nodes/executor.py": """"'executor' — create_agent 로 만든 완성형 ReAct 에이전트를 노드로 사용한다.

에이전트 내부에서 모델 호출 ↔ 도구 실행 루프가 돌고, 최종 답변만 부모 그래프로 돌려준다
(컨텍스트 격리: 부모 대화에 도구 호출 기록이 쌓이지 않는다)."""

from langchain.agents import create_agent
from langchain.messages import AIMessage

from agent.config import MODEL
from agent.state import State
from agent.tools import TOOLS

PROMPT = "승인된 처리안대로 환불을 실행하고 결과를 고객에게 안내하세요."

_agent = create_agent(
    MODEL,
    tools=[TOOLS["issue_refund"]],
    system_prompt=PROMPT,
    name="executor",
)


def executor(state: State) -> dict:
    """하위 에이전트를 실행하고 최종 답변만 반환한다."""
    result = _agent.invoke({"messages": state["messages"]})
    answer = result["messages"][-1]
    return {"messages": [AIMessage(content=answer.text, name="executor")]}
",
  "agent/nodes/support_agent.py": """"'support_agent' — create_agent 로 만든 완성형 ReAct 에이전트를 노드로 사용한다.

에이전트 내부에서 모델 호출 ↔ 도구 실행 루프가 돌고, 최종 답변만 부모 그래프로 돌려준다
(컨텍스트 격리: 부모 대화에 도구 호출 기록이 쌓이지 않는다)."""

from langchain.agents import create_agent
from langchain.messages import AIMessage

from agent.config import MODEL
from agent.state import State
from agent.tools import TOOLS

PROMPT = "고객 요청을 조사하고 환불 처리 계획을 제안하세요. 아직 환불을 실행하지 마세요."

_agent = create_agent(
    MODEL,
    tools=[TOOLS["get_order_status"], TOOLS["search_docs"]],
    system_prompt=PROMPT,
    name="support_agent",
)


def support_agent(state: State) -> dict:
    """하위 에이전트를 실행하고 최종 답변만 반환한다."""
    result = _agent.invoke({"messages": state["messages"]})
    answer = result["messages"][-1]
    return {"messages": [AIMessage(content=answer.text, name="support_agent")]}
",
  "agent/routing.py": """"라우팅 함수 모음: add_conditional_edges 에 전달된다.

라우팅 함수는 노드가 아니다. 상태를 읽고 '다음에 갈 곳'만 반환한다.
반환 타입의 Literal 은 그래프 시각화와 정적 검증에 사용된다.
"""

from typing import Literal



from agent.state import State


def route_approval(state: State) -> Literal["approve", "reject"]:
    """사람의 결정에 따라 분기한다."""
    return "reject" if state.get("approval_decision") == "reject" else "approve"
",
  "agent/state.py": """"그래프 상태(State) 정의.

MessagesState 는 \`messages: Annotated[list[AnyMessage], add_messages]\` 를 포함한다.
add_messages 리듀서 덕분에 노드가 반환한 메시지는 덮어쓰지 않고 '추가'된다.
"""

from langgraph.graph import MessagesState


class State(MessagesState, total=False):
    """에이전트 전체가 공유하는 상태."""

    approval_decision: str  # "approve" | "reject"
",
  "agent/tools.py": """"에이전트가 사용할 도구(Tool) 정의.

@tool 데코레이터는 함수 시그니처와 docstring 으로 JSON 스키마를 만들어 LLM 에 전달한다.
docstring 은 LLM 이 도구를 '언제' 쓸지 판단하는 근거이므로 구체적으로 쓴다.
"""

from langchain.tools import tool


@tool
def get_order_status(order_id: str) -> str:
    """주문 번호로 주문/배송 상태를 조회합니다."""
    return f"주문 {order_id}: 결제 완료 → 배송 중 (예상 도착: 내일)"


@tool
def search_docs(query: str) -> str:
    """사내 지식베이스(FAQ)에서 관련 문서를 찾습니다."""
    faq = {
        "환불": "환불은 결제 후 14일 이내 가능하며, 영업일 기준 3~5일 소요됩니다.",
        "배송": "기본 배송은 2~3일, 제주/도서산간은 추가 1~2일이 걸립니다.",
        "비밀번호": "설정 > 보안 > 비밀번호 재설정에서 이메일 인증 후 변경할 수 있습니다.",
    }
    hits = [f"[{k}] {v}" for k, v in faq.items() if k in query]
    return "\\n".join(hits) or "관련 문서를 찾지 못했습니다."


@tool
def issue_refund(order_id: str, amount: int) -> str:
    """주문에 대해 환불을 실행합니다. (민감한 작업 — 운영에서는 HITL 승인 필수)"""
    return f"주문 {order_id} 에 {amount:,}원 환불 요청이 접수되었습니다."


TOOLS = {"get_order_status": get_order_status, "search_docs": search_docs, "issue_refund": issue_refund}
",
  "langgraph.json": "{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
