"""

import pytest


@pytest.fixture(autouse=True)
def _fake_key(monkeypatch):
    # 모델 객체를 만들 때 키가 있어야 하지만, 이 테스트는 모델을 호출하지 않는다
    monkeypatch.setenv("OPENAI_API_KEY", "test-key-not-used")


