",
  "README.md": "# LangGraph Agent (AgentLab Playground 생성)

\`\`\`mermaid
flowchart TD
  __start__([START])
  assistant[assistant]
  should_continue{should_continue}
  tools[tools]
  __end__([END])
  __start__ --> assistant
  assistant --> should_continue
  should_continue -.-> tools
  should_continue -.-> __end__
  tools --> assistant
\`\`\`

## 실행

\`\`\`bash
pip install -r requirements.txt
cp .env.example .env  # OPENAI_API_KEY 입력
python main.py
\`\`\`

## 구조

| 파일 | 역할 |
| --- | --- |
| \`agent/state.py\` | 공유 상태 스키마와 리듀서 |
| \`agent/nodes/*.py\` | 노드별 구현 (assistant, tools) |
| \`agent/routing.py\` | 조건부 엣지 라우팅 함수 / Send fan-out |
| \`agent/tools.py\` | 도구 정의 |
| \`agent/graph.py\` | StateGraph 조립 및 컴파일 |
| \`main.py\` | 스트리밍 실행 데모 |
| \`langgraph.json\` | LangGraph Server(Agent Server) 배포 설정 |

## 배포

\`\`\`bash
pip install -U "langgraph-cli[inmem]"
langgraph dev   # 로컬 Agent Server + Studio
\`\`\`
",
  "agent/__init__.py": """"AgentLab 플레이그라운드에서 생성된 LangGraph 에이전트."""
",
  "agent/config.py": """"공통 설정: 모델 ID 는 환경변수에서 읽는다 (12-factor)."""

import os

from langchain.chat_models import init_chat_model

MODEL = os.getenv("LAB_MODEL", "openai:gpt-5-mini")


def get_llm(model: str | None = None):
    """채팅 모델 인스턴스. model 을 주면 그 모델(노드별 지정), 아니면 LAB_MODEL.

    GPT-5 계열은 temperature 를 지원하지 않으므로 지정하지 않는다.
    """
    return init_chat_model(model or MODEL)
",
  "agent/graph.py": """"그래프 조립: 노드 등록 → 엣지 연결 → 컴파일.

이 파일은 플레이그라운드 캔버스의 구조를 그대로 반영한다.
"""

from langgraph.checkpoint.memory import InMemorySaver
from langgraph.graph import END, START, StateGraph
from langgraph.types import RetryPolicy

from agent.nodes import assistant, tools
from agent.routing import should_continue
from agent.state import State


def build_graph(checkpointer=None, use_default_checkpointer: bool = True):
    """StateGraph 를 구성하고 컴파일한다."""
    builder = StateGraph(State)

    builder.add_node("assistant", assistant, retry_policy=RetryPolicy(max_attempts=3))
    builder.add_node("tools", tools)

    builder.add_edge(START, "assistant")
    builder.add_conditional_edges("assistant", should_continue, {"tools": "tools", "__end__": END})
    builder.add_edge("tools", "assistant")

    if checkpointer is None and use_default_checkpointer:
        checkpointer = InMemorySaver()
    return builder.compile(checkpointer=checkpointer, name="agent")


# LangGraph Server(langgraph.json)용 export — 서버가 자체 체크포인터를 주입한다.
graph = build_graph(use_default_checkpointer=False)
",
  "agent/nodes/__init__.py": """"노드 패키지: 각 노드는 개별 모듈로 분리되어 있다."""

from agent.nodes.assistant import assistant
from agent.nodes.tools import tools

__all__ = ["assistant", "tools"]
",
  "agent/nodes/assistant.py": """"'assistant' — LLM 노드. 도구가 바인딩되어 있어 tool_calls 를 생성할 수 있다."""

from langchain.messages import SystemMessage

from agent.config import get_llm
from agent.state import State
from agent.tools import TOOLS

PROMPT = "당신은 도구를 활용하는 여행 도우미입니다. 필요한 정보는 도구로 조회하세요."
# 이 노드 뒤의 tools_condition 라우터가 가리키는 ToolNode 의 도구를 바인딩한다.
llm = get_llm().bind_tools([TOOLS[name] for name in ["get_weather","web_search","calculator"]])


def assistant(state: State) -> dict:
    """대화 기록을 모델에 전달하고 응답 메시지를 상태에 추가한다."""
    system = PROMPT
    response = llm.invoke([SystemMessage(system), *state["messages"]])
    return {"messages": [response]}
",
  "agent/nodes/tools.py": """"'tools' — ToolNode: 직전 AIMessage 의 tool_calls 를 실행해 ToolMessage 로 돌려준다.

handle_tool_errors=True 이면 도구 예외를 오류 메시지로 바꿔 LLM 이 스스로 복구할 기회를 준다."""

from langgraph.prebuilt import ToolNode

from agent.tools import TOOLS

tools = ToolNode([TOOLS["get_weather"], TOOLS["web_search"], TOOLS["calculator"]], handle_tool_errors=True)
",
  "agent/routing.py": """"라우팅 함수 모음: add_conditional_edges 에 전달된다.

라우팅 함수는 노드가 아니다. 상태를 읽고 '다음에 갈 곳'만 반환한다.
반환 타입의 Literal 은 그래프 시각화와 정적 검증에 사용된다.
"""

from typing import Literal



from agent.state import State


def should_continue(state: State) -> Literal["tools", "__end__"]:
    """tools_condition: 마지막 AIMessage 에 tool_calls 가 있으면 도구 노드로, 없으면 다음 단계로."""
    last = state["messages"][-1]
    if getattr(last, "tool_calls", None):
        return "tools"
    return "__end__"
",
  "agent/state.py": """"그래프 상태(State) 정의.

MessagesState 는 \`messages: Annotated[list[AnyMessage], add_messages]\` 를 포함한다.
add_messages 리듀서 덕분에 노드가 반환한 메시지는 덮어쓰지 않고 '추가'된다.
"""

from langgraph.graph import MessagesState


class State(MessagesState, total=False):
    """에이전트 전체가 공유하는 상태."""

    pass
",
  "agent/tools.py": """"에이전트가 사용할 도구(Tool) 정의.

@tool 데코레이터는 함수 시그니처와 docstring 으로 JSON 스키마를 만들어 LLM 에 전달한다.
docstring 은 LLM 이 도구를 '언제' 쓸지 판단하는 근거이므로 구체적으로 쓴다.
"""

from langchain.tools import tool


@tool
def get_weather(city: str) -> str:
    """도시의 현재 날씨를 조회합니다."""
    data = {"서울": "맑음, 18°C", "부산": "구름 조금, 21°C", "도쿄": "비, 16°C", "뉴욕": "흐림, 12°C"}
    return f"{city}: {data.get(city, '맑음, 20°C')}"


@tool
def web_search(query: str) -> str:
    """웹에서 정보를 검색해 상위 결과를 요약합니다. (데모용 고정 데이터)"""
    corpus = {
        "langgraph": "LangGraph 는 상태 기반 그래프로 장기 실행·멀티 에이전트 워크플로를 만드는 오케스트레이션 프레임워크입니다.",
        "여행": "가을 서울 여행은 북촌 한옥마을, 경복궁 야간개장, 한강 공원 피크닉이 인기입니다.",
        "ai": "2026년 AI 에이전트는 MCP 기반 도구 연동, 장기 메모리, 평가 자동화가 핵심 트렌드입니다.",
    }
    hits = [v for k, v in corpus.items() if k in query.lower()]
    return "\\n".join(hits) or f"'{query}' 에 대한 검색 결과: 관련 문서 3건 (요약 생략)"


@tool
def calculator(expression: str) -> str:
    """사칙연산/거듭제곱 수식을 계산합니다. 예: '(3 + 4) * 2'"""
    import ast
    import operator as op

    ops = {ast.Add: op.add, ast.Sub: op.sub, ast.Mult: op.mul, ast.Div: op.truediv, ast.Pow: op.pow, ast.USub: op.neg}

    def ev(node: ast.AST) -> float:
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in ops:
            return ops[type(node.op)](ev(node.left), ev(node.right))
        if isinstance(node, ast.UnaryOp) and type(node.op) in ops:
            return ops[type(node.op)](ev(node.operand))
        raise ValueError("지원하지 않는 수식입니다")

    try:
        return str(ev(ast.parse(expression, mode="eval").body))
    except Exception as exc:  # 도구 오류는 문자열로 돌려줘 LLM 이 스스로 복구하게 한다
        return f"계산 실패: {exc}"


TOOLS = {"get_weather": get_weather, "web_search": web_search, "calculator": calculator}
",
  "langgraph.json": "{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent": "./agent/graph.py:graph"
  },
  "env": ".env"
}
",
  "main.py": """"실행 진입점: 데모 입력으로 그래프를 스트리밍 실행한다.

    python main.py
"""

import uuid

from langgraph.errors import GraphRecursionError

from agent.graph import build_graph

DEMO_INPUT = "서울 날씨를 알려주고 여행 팁도 추천해줘"


def show(update: object) -> None:
    """노드가 반환한 상태 업데이트를 읽기 좋게 출력한다."""
    if not isinstance(update, dict):
        return
    for msg in update.get("messages", []) or []:
        role = getattr(msg, "type", "?")
        name = f"({msg.name})" if getattr(msg, "name", None) else ""
        if getattr(msg, "tool_calls", None):
            calls = ", ".join(f"{t['name']}({t['args']})" for t in msg.tool_calls)
            print(f"   [{role}{name}] 🛠  {calls}")
        else:
            print(f"   [{role}{name}] {str(msg.content)[:400]}")
    for key, value in update.items():
        if key != "messages":
            print(f"   · {key} = {str(value)[:200]}")


def run(graph, payload, config) -> list:
    """스트리밍 실행. interrupt 가 발생하면 그 값들을, 끝까지 돌면 빈 리스트를 반환한다."""
    for chunk in graph.stream(payload, config, stream_mode="updates"):
        for node, update in chunk.items():
            if node == "__interrupt__":
                for it in update:
                    print(f"\\n⏸  interrupt: {it.value}")
                return [it.value for it in update]
            print(f"\\n▶ {node}")
            show(update)
    return []



def main() -> None:
    graph = build_graph()
    config = {"configurable": {"thread_id": str(uuid.uuid4())}, "recursion_limit": 25, "run_name": "agentlab-demo", "tags": ["agentlab", "demo"], "metadata": {"source": "agentlab-playground"}}
    print("노드:", ", ".join(n for n in graph.get_graph().nodes if not n.startswith("__")))
    print(f"입력: {DEMO_INPUT}")
    try:
        interrupted = run(graph, {"messages": [{"role": "user", "content": DEMO_INPUT}]}, config)
        if interrupted:
            print("(interrupt 발생 — Command(resume=...) 로 재개하세요)")
    except GraphRecursionError:
        print("\\n⛔ recursion_limit 초과: 루프의 종료 조건을 확인하세요.")
        raise
    print("\\n✅ 실행 완료")


if __name__ == "__main__":
    main()
