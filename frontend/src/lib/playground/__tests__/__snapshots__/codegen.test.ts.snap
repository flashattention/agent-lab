from langchain.messages import SystemMessage

from agent.config import get_llm
from agent.subagents.writing_team.state import State

PROMPT = "당신은 테크니컬 라이터입니다. 대화에 모인 정보로 짧은 보고서를 쓰세요. 피드백이 있으면 반영하세요."
llm = get_llm()


def drafter(state: State) -> dict:
    """대화 기록을 모델에 전달하고 응답 메시지를 상태에 추가한다."""
    system = PROMPT
    response = llm.invoke([SystemMessage(system), *state["messages"]])
