",
  "README.md": "# LangGraph Agent (AgentLab Playground 생성)

\`\`\`mermaid
flowchart TD
  __start__([START])
  supervisor[supervisor]
  subgraph research_team [research_team]
    research_team____start__([START])
    research_team__researcher[researcher]
    research_team__need_tools{need_tools}
    research_team__research_tools[research_tools]
    research_team____end__([END])
    research_team____start__ --> research_team__researcher
    research_team__researcher --> research_team__need_tools
    research_team__need_tools -.-> research_team__research_tools
    research_team__need_tools -.-> research_team____end__
    research_team__research_tools --> research_team__researcher
  end
  subgraph writing_team [writing_team]
    writing_team____start__([START])
    writing_team__drafter[drafter]
    writing_team__review[review]
    writing_team____end__([END])
    writing_team____start__ --> writing_team__drafter
    writing_team__drafter --> writing_team__review
    writing_team__review -.->|pass| writing_team____end__
    writing_team__review -.->|retry| writing_team__drafter
  end
  __end__([END])
  __start__ --> supervisor
  supervisor -.-> research_team
  supervisor -.-> writing_team
  research_team --> supervisor
  writing_team --> supervisor
  supervisor -.-> __end__
\`\`\`

## 실행

\`\`\`bash
pip install -r requirements.txt
cp .env.example .env  # OPENAI_API_KEY 입력
python main.py
\`\`\`

## 구조

| 파일 | 역할 |
| --- | --- |
| \`agent/state.py\` | 공유 상태 스키마와 리듀서 |
| \`agent/nodes/*.py\` | 노드별 구현 (supervisor, research_team, writing_team) |
| \`agent/subagents/<이름>/\` | 서브 에이전트 패키지 (각자 state/nodes/routing/graph) |
| \`agent/tools.py\` | 도구 정의 |
| \`agent/graph.py\` | StateGraph 조립 및 컴파일 |
| \`main.py\` | 스트리밍 실행 데모 |
| \`langgraph.json\` | LangGraph Server(Agent Server) 배포 설정 |

## 서브 에이전트

| 경로 | 노드 | 입출력 | 메모리 | 역할 |
| --- | --- | --- | --- | --- |
| \`agent/subagents/research_team/\` | research_team | 격리 (최종 답변만) | 부모 상속 | 웹 검색과 계산으로 사실과 수치를 조사 |
| \`agent/subagents/writing_team/\` | writing_team | 격리 (최종 답변만) | 부모 상속 | 조사 결과로 보고서를 쓰고 스스로 검토해 다듬음 |

각 서브 에이전트는 독립된 패키지라서 단독으로 실행·테스트할 수 있고, \`langgraph dev\` 에서도 별도 그래프로 열립니다.

## 배포

\`\`\`bash
pip install -U "langgraph-cli[inmem]"
langgraph dev   # 로컬 Agent Server + Studio
\`\`\`
",
  "agent/__init__.py": """"AgentLab 플레이그라운드에서 생성된 LangGraph 에이전트."""
",
  "agent/config.py": """"공통 설정: 모델 ID 는 환경변수에서 읽는다 (12-factor)."""

import os

from langchain.chat_models import init_chat_model

MODEL = os.getenv("LAB_MODEL", "openai:gpt-5-mini")


def get_llm(model: str | None = None):
    """채팅 모델 인스턴스. model 을 주면 그 모델(노드별 지정), 아니면 LAB_MODEL.

    GPT-5 계열은 temperature 를 지원하지 않으므로 지정하지 않는다.
    """
    return init_chat_model(model or MODEL)
",
  "agent/graph.py": """"그래프 조립: 노드 등록 → 엣지 연결 → 컴파일.

이 파일은 플레이그라운드 캔버스의 구조를 그대로 반영한다.
"""

from langgraph.checkpoint.memory import InMemorySaver
from langgraph.graph import START, StateGraph

from agent.nodes import research_team, supervisor, writing_team
from agent.state import State


def build_graph(checkpointer=None, use_default_checkpointer: bool = True):
    """StateGraph 를 구성하고 컴파일한다."""
    builder = StateGraph(State)

    builder.add_node("supervisor", supervisor, destinations=("research_team", "writing_team", "__end__"))
    builder.add_node("research_team", research_team)
    builder.add_node("writing_team", writing_team)

    builder.add_edge(START, "supervisor")
    builder.add_edge("research_team", "supervisor")
    builder.add_edge("writing_team", "supervisor")

    if checkpointer is None and use_default_checkpointer:
        checkpointer = InMemorySaver()
    return builder.compile(checkpointer=checkpointer, name="agent")


# LangGraph Server(langgraph.json)용 export — 서버가 자체 체크포인터를 주입한다.
graph = build_graph(use_default_checkpointer=False)
