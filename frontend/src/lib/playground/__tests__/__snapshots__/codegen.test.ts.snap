  "agent/subagents/research_team/graph.py": """"서브그래프 'research_team' 조립.

부모 그래프의 노드로 쓰이는 하위 에이전트다. 체크포인터는 부모에서 자동으로 이어받으므로
여기서 따로 만들지 않는다.
단독으로 테스트하려면: python -c "from agent.subagents.research_team.graph import graph; print(graph.invoke({'messages': [('user', '안녕')]}))"
"""

from langgraph.graph import END, START, StateGraph
from langgraph.types import RetryPolicy

from agent.subagents.research_team.nodes import research_tools, researcher
from agent.subagents.research_team.routing import need_tools
from agent.subagents.research_team.state import State


def build_graph(checkpointer=None):
    """하위 StateGraph 를 구성하고 컴파일한다."""
    builder = StateGraph(State)

    builder.add_node("researcher", researcher, retry_policy=RetryPolicy(max_attempts=3))
    builder.add_node("research_tools", research_tools)

    builder.add_edge(START, "researcher")
    builder.add_conditional_edges("researcher", need_tools, {"research_tools": "research_tools", "__end__": END})
    builder.add_edge("research_tools", "researcher")

    return builder.compile(checkpointer=checkpointer, name="research_team")


graph = build_graph()
